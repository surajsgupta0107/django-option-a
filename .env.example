# Copy to .env and adjust.

# Admin access is now real per-user login (django.contrib.auth), not a shared key —
# create accounts with `python manage.py createsuperuser` (admin) or via /admin/
# (owners: uncheck "staff status", set their email to match Server.owner_email).
OWNER_LINK_SECRET=dev-owner-link-secret-change-me
FRONTEND_BASE_URL=http://localhost:8000

# Leave SMTP_HOST blank to have reminder emails logged to the console instead of sent —
# handy for local development without a real mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=infra-ops@company.com
SMTP_USE_TLS=true
