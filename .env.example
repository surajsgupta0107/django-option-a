# Copy to .env and adjust. Used by docker-compose.yml for both backend stacks.

ADMIN_API_KEY=dev-admin-key-change-me
OWNER_LINK_SECRET=dev-owner-link-secret-change-me
FRONTEND_BASE_URL=http://localhost:8000

# Leave SMTP_HOST blank to have reminder emails logged to the console instead of sent —
# handy for local development without a real mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=infra-ops@company.com
SMTP_USE_TLS=true
